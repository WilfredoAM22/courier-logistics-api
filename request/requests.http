@baseUrl = http://localhost:8081/api/v1

### 1. Cotización Aduanal DGA — Paquete Exento (<= 200 USD FOB)
POST {{baseUrl}}/quotes
Content-Type: application/json

{
  "weightInLbs": 2.5,
  "fobValue": 180.00,
  "category": "ELECTRONICS"
}

### 2. Cotización Aduanal DGA — Paquete Gravado en Cascada (> 200 USD FOB)
POST {{baseUrl}}/quotes
Content-Type: application/json

{
  "weightInLbs": 4.5,
  "fobValue": 950.00,
  "category": "ELECTRONICS"
}

### 3. Validación de Contrato (@Valid) — Error 400 Bad Request (Peso o valor negativo)
POST {{baseUrl}}/quotes
Content-Type: application/json

{
  "weightInLbs": -1.0,
  "fobValue": 0.00,
  "category": "CLOTHING"
}

### 4. Registrar Nuevo Paquete en Almacén de Miami (Guarda tracking1)
POST {{baseUrl}}/shipments
Content-Type: application/json

{
  "description": "Laptop MacBook Air M3",
  "weightInLbs": 4.5,
  "fobValue": 950.00,
  "category": "ELECTRONICS",
  "originLocation": "Almacén Doral, Miami, FL"
}

> {%
    const id = response.body.trackingNumber || response.body.trackingCode || response.body.id;
    client.global.set("tracking1", id);
%}

### 5. Consultar Envío y su Línea de Tiempo por Tracking
GET {{baseUrl}}/shipments/{{tracking1}}

### 6. Máquina de Estados — Error 409 Conflict (Salto ilegal directo a DELIVERED desde RECEIVED_MIAMI)
PATCH {{baseUrl}}/shipments/{{tracking1}}/status
Content-Type: application/json

{
  "newStatus": "DELIVERED",
  "location": "Sucursal La Romana",
  "notes": "Intento de entrega sin pasar por aduanas"
}

### 7. Verificación de Ruta y Verbo — Error 405 Method Not Allowed (PATCH sin /status)
PATCH {{baseUrl}}/shipments/{{tracking1}}
Content-Type: application/json

{
  "newStatus": "IN_TRANSIT",
  "location": "Vuelo MIA -> SDQ"
}

### 8. Ciclo Completo — Paso 1: Avanzar Estado Logístico (RECEIVED_MIAMI -> IN_TRANSIT)
PATCH {{baseUrl}}/shipments/{{tracking1}}/status
Content-Type: application/json

{
  "newStatus": "IN_TRANSIT",
  "location": "Vuelo de carga MIA -> SDQ",
  "notes": "Paquete embarcado hacia Santo Domingo"
}

### 9. Ciclo Completo — Paso 2: Ingreso a Aduanas DGA (IN_TRANSIT -> CUSTOMS_CLEARANCE)
PATCH {{baseUrl}}/shipments/{{tracking1}}/status
Content-Type: application/json

{
  "newStatus": "CUSTOMS_CLEARANCE",
  "location": "Terminal de Carga AILA (SDQ)",
  "notes": "Manifiesto presentado ante Dirección General de Aduanas"
}

### 10. Ciclo Completo — Paso 3: Disponible en Sucursal Local (CUSTOMS_CLEARANCE -> READY_FOR_PICKUP)
PATCH {{baseUrl}}/shipments/{{tracking1}}/status
Content-Type: application/json

{
  "newStatus": "READY_FOR_PICKUP",
  "location": "Sucursal La Romana — Av. Santa Rosa",
  "notes": "Paquete clasificado y listo para retiro en mostrador"
}

### 11. Ciclo Completo — Paso 4: Entrega Final al Cliente (READY_FOR_PICKUP -> DELIVERED)
PATCH {{baseUrl}}/shipments/{{tracking1}}/status
Content-Type: application/json

{
  "newStatus": "DELIVERED",
  "location": "Sucursal La Romana — Av. Santa Rosa",
  "notes": "Entregado con firma y cédula verificada"
}

### 12. Máquina de Estados — Error 409 Conflict (Intentar modificar un paquete ya DELIVERED)
PATCH {{baseUrl}}/shipments/{{tracking1}}/status
Content-Type: application/json

{
  "newStatus": "CANCELED",
  "location": "Sucursal La Romana",
  "notes": "Intento de cancelación posterior a entrega"
}

### 13. Consulta de Tracking Inexistente — Error 404 Not Found
GET {{baseUrl}}/shipments/DOM-MIA-000000

### 14. Cotización DGA — Categoría Especial Exenta (Libros / Cultura)
POST {{baseUrl}}/quotes
Content-Type: application/json

{
  "weightInLbs": 3.0,
  "fobValue": 320.00,
  "category": "BOOKS"
}

### 15. Cotización DGA — Producto con Impuesto Selectivo al Consumo (Suplementos > 200 USD)
POST {{baseUrl}}/quotes
Content-Type: application/json

{
  "weightInLbs": 5.2,
  "fobValue": 260.00,
  "category": "SUPPLEMENTS"
}

### 16. Validación de Contrato — Categoría o Enum Inválido (Error 400 Bad Request)
POST {{baseUrl}}/quotes
Content-Type: application/json

{
  "weightInLbs": 2.0,
  "fobValue": 100.00,
  "category": "VEHICLES"
}

### 17. Registrar Segundo Paquete (Guarda tracking2 para pruebas de cancelación)
POST {{baseUrl}}/shipments
Content-Type: application/json

{
  "description": "Zapatillas Deportivas Running",
  "weightInLbs": 2.2,
  "fobValue": 125.00,
  "category": "CLOTHING",
  "originLocation": "Almacén Doral, Miami, FL"
}

> {%
    const id = response.body.trackingNumber || response.body.trackingCode || response.body.id;
    client.global.set("tracking2", id);
%}

### 18. Prueba A — Ortografía con doble LL ("CANCELLED" -> Error 400 Bad Request por enum desconocido)
PATCH {{baseUrl}}/shipments/{{tracking2}}/status
Content-Type: application/json

{
  "newStatus": "CANCELLED",
  "location": "Almacén Doral, Miami, FL",
  "notes": "Prueba con doble LL para verificar rechazo de deserialización"
}

### 19. Prueba B — Cancelación Válida con Enum Exacto ("CANCELED" -> 200 OK)
PATCH {{baseUrl}}/shipments/{{tracking2}}/status
Content-Type: application/json

{
  "newStatus": "CANCELED",
  "location": "Almacén Doral, Miami, FL",
  "notes": "Cancelación oficial con el nombre exacto del enum"
}

### 20. Máquina de Estados — Error 409 Conflict (Intentar mover un paquete ya CANCELED)
PATCH {{baseUrl}}/shipments/{{tracking2}}/status
Content-Type: application/json

{
  "newStatus": "READY_FOR_PICKUP",
  "location": "Sucursal La Romana",
  "notes": "Intento de reactivación de paquete cancelado"
}
